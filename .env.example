# ---------------------------------------------------------------------------
# Polymarket BTC market bot — copy to .env (setup.bat does this for you)
# ---------------------------------------------------------------------------

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for the control API. Leave empty on 127.0.0.1; REQUIRED if HOST is not loopback.
# Clients send it as X-API-Key (or Authorization: Bearer); the WebSocket uses ?token=.
API_TOKEN=
# Dashboard login. Username defaults to "admin"; set your own password here (CHANGE IT).
# Log in once per browser: the session stays valid for AUTH_SESSION_DAYS and survives restarts.
# Empty ADMIN_PASSWORD = login disabled. Changing the password logs every browser out.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-123
# Optional extra secret mixed into the session signature (leave empty if unsure)
AUTH_SECRET=
AUTH_SESSION_DAYS=365
LOG_LEVEL=INFO

# Database (absolute or relative; relative resolves against the repo root)
DATABASE_URL=sqlite:///data/polymarket_bot.db

# Strategy defaults — the final window and trigger are configurable
TRIGGER_THRESHOLD=0.80
FINAL_WINDOW_SECONDS=80
# Add-on entries: one more buy per stage when this many seconds (or fewer) remain
# and a best ask is at or above the stage threshold
STAGE2_SECONDS=50
STAGE2_THRESHOLD=0.90
STAGE3_SECONDS=30
STAGE3_THRESHOLD=0.90
# Must be <= 1 - tick size (0.99 for the usual 0.01 tick); higher caps are clamped at order time
MAX_EXECUTION_PRICE=0.99
# Price-to-beat filter (USD): buy UP only if BTC >= price to beat + gap, DOWN only if BTC <= price to beat - gap.
# 0 disables it. While enabled, missing/stale BTC price data blocks buys (see BTC_PRICE_ENABLED).
MIN_PRICE_GAP_USD=20
STAGE2_MIN_PRICE_GAP_USD=25
STAGE3_MIN_PRICE_GAP_USD=30
# Stage 0: early buy + take-profit sell, independent of stages 1-3. From STAGE0_START_SECONDS left until
# STAGE0_END_SECONDS left (independent of the final window), buy a side whose best ask is between STAGE0_MIN_ASK and STAGE0_MAX_ASK while BTC is >= STAGE0_MIN_PRICE_GAP_USD
# beyond the price to beat in that direction; sell once the best bid is the tier's take-profit percentage above the buy price.
STAGE0_ENABLED=true
STAGE0_START_SECONDS=200
STAGE0_END_SECONDS=100
STAGE0_MIN_ASK=0.60
STAGE0_MAX_ASK=0.99
STAGE0_MIN_PRICE_GAP_USD=80
# Stage 0 take-profit in percent above the average buy price, by what stage 0 paid per share (sell price capped at bid 0.99):
# below STAGE0_MID_FROM_ASK -> LOW %, below STAGE0_HIGH_FROM_ASK -> MID %, otherwise HIGH %. 0 = no take-profit for that tier.
# Defaults: bought 0.60-0.70 -> +15%, 0.70-0.80 -> +10%, 0.80-0.85 -> +5%.
STAGE0_MID_FROM_ASK=0.70
STAGE0_HIGH_FROM_ASK=0.80
STAGE0_TAKE_PROFIT_PCT_LOW=15
STAGE0_TAKE_PROFIT_PCT_MID=10
STAGE0_TAKE_PROFIT_PCT_HIGH=5
# Stage 1 take-profit: stage 1 shares that cost up to STAGE1_SELL_MAX_BUY per share are sold again as soon as the
# best bid is STAGE1_TAKE_PROFIT_PCT percent above what they cost (0 = no take-profit for them);
# shares that cost more are sold at STAGE1_SELL_PRICE_HIGH
STAGE1_SELL_ENABLED=true
STAGE1_SELL_MAX_BUY=0.86
STAGE1_TAKE_PROFIT_PCT=10
STAGE1_SELL_PRICE_HIGH=0.99
# Stage 2 take-profit: stage 2 shares are sold again as soon as the best bid reaches STAGE2_SELL_PRICE
STAGE2_SELL_ENABLED=true
STAGE2_SELL_PRICE=0.99
# Stop-loss per stage, in percent below the average price paid per share. When the best bid is at or below
# cost * (1 - pct/100), that stage's own shares are sold at the market. 0 = off for that stage.
# Example: stage 0 bought at 0.70 with 40 -> sold once the best bid is 0.42 or lower.
STAGE0_STOP_LOSS_PCT=50
STAGE1_STOP_LOSS_PCT=15
STAGE2_STOP_LOSS_PCT=9
STAGE3_STOP_LOSS_PCT=5
# Stage 0 shares bought at STAGE0_HIGH_BUY_PRICE or more use this tighter stop-loss instead of
# STAGE0_STOP_LOSS_PCT. 0 = off. Stage 0 only buys up to STAGE0_MAX_ASK (default 0.99).
STAGE0_HIGH_BUY_PRICE=0.90
STAGE0_HIGH_BUY_STOP_LOSS_PCT=15
# Buys at STAGE0_HIGH_BUY_PRICE or more only start once this percent of the stage 0 window (START -> END) has passed:
# 50 with 200 -> 100 = from 150s left. 0 = the whole window. Cheaper buys can happen the whole window.
STAGE0_HIGH_BUY_AFTER_PCT=50
TRADE_AMOUNT_USDC=1.0
STALE_DATA_MAX_AGE_MS=2000
MAX_OPEN_POSITIONS=1
# one_per_market | one_per_side | allow
DUPLICATE_POLICY=one_per_market
# up_first | down_first | highest_ask | block_both
CONFLICT_POLICY=up_first

# Risk
MAX_DAILY_LOSS=5.0
DAILY_PROFIT_TARGET=10.0
MAX_TRADES_PER_DAY=600

# Paper trading
PAPER_STARTING_BALANCE=10.0
PAPER_FILL_RATIO=1.0
PAPER_SLIPPAGE_BPS=0
# Taker fee = shares * rate * (p * (1-p))^exponent. Crypto taker rate is 0.07, exponent 1 per docs.polymarket.com/trading/fees.
# Live fills use the market's own fee parameters from the CLOB; these two values are the paper rate and the live fallback.
PAPER_FEE_RATE=0.07
PAPER_FEE_EXPONENT=1.0

# Live trading — ENABLED in this example file (owner decision). Set LIVE_TRADING_ENABLED=false to stay paper-only.
LIVE_TRADING_ENABLED=true
LIVE_CONFIRMATION_PHRASE=GO LIVE
# true = the operator confirms Polymarket is allowed in their jurisdiction.
POLYMARKET_GEO_VERIFIED=true
# Winning tokens turn into pUSD only after REDEEM (official docs: trading/positions/manage).
# true = bot redeems resolved winning positions itself (needs `pip install polymarket-client`).
# With a Relayer API key (polymarket.com > Settings > API Keys) redemption is gasless;
# without one it is an EOA transaction that needs a little POL for gas.
LIVE_AUTO_REDEEM=true
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Wallet credentials (LIVE only; never exposed by the API). CLOB V2 uses pUSD collateral.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = email/magic proxy, 2 = browser proxy, 3 = smart-contract / deposit wallet
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_CHAIN_ID=137
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket endpoints (defaults are correct)
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
SERIES_SLUG=btc-up-or-down-5m
EVENT_SLUG_PREFIX=btc-updown-5m

# Runtime loops (discovery only; execution is websocket event-driven)
DISCOVERY_REFRESH_SECONDS=3
RESOLUTION_POLL_SECONDS=5
