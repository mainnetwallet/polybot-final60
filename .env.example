# ---------------------------------------------------------------------------
# Polymarket Final-60s BTC bot — copy to .env (setup.bat does this for you)
# ---------------------------------------------------------------------------

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Database (absolute or relative; relative resolves against the repo root)
DATABASE_URL=sqlite:///data/polymarket_bot.db

# Strategy — first 4 minutes never trade, final 60 seconds monitor UP/DOWN
TRIGGER_THRESHOLD=0.80
FINAL_WINDOW_SECONDS=60
MAX_EXECUTION_PRICE=0.99
TRADE_AMOUNT_USDC=5.0
STALE_DATA_MAX_AGE_MS=2000
MAX_OPEN_POSITIONS=1
# one_per_market | one_per_side | allow
DUPLICATE_POLICY=one_per_market
# up_first | down_first | highest_ask | block_both
CONFLICT_POLICY=up_first

# Risk
MAX_DAILY_LOSS=5.0
DAILY_PROFIT_TARGET=10.0
MAX_TRADES_PER_DAY=60

# Paper trading
PAPER_STARTING_BALANCE=10.0
PAPER_FILL_RATIO=1.0
PAPER_SLIPPAGE_BPS=0
# Approximate taker fee per verified crypto_fees_v2 schedule; tune after docs review.
PAPER_FEE_RATE=0.07
PAPER_FEE_EXPONENT=1.0

# Live trading — DISABLED BY DEFAULT. Never enabled automatically.
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=GO LIVE
# Keep false until Polymarket eligibility for your jurisdiction is verified.
POLYMARKET_GEO_VERIFIED=false

# Wallet credentials (LIVE only; never exposed by the API)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA, 1 = email/magic proxy, 2 = browser proxy
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket endpoints (defaults are correct)
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
SERIES_SLUG=btc-up-or-down-5m

# Runtime loops (discovery only; execution is websocket event-driven)
DISCOVERY_REFRESH_SECONDS=3
RESOLUTION_POLL_SECONDS=10
